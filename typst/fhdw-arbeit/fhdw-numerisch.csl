<?xml version="1.0" encoding="utf-8"?>
<!--
  FHDW numerisch – Nummern wie [1] in Reihenfolge der Zitate (FHDW-Hinweise S. 8).
  Abgeleitet aus fhdw-alphanumerisch.csl; Änderungen an den Einträgen in beiden Dateien nachziehen.
  Angaben je Quellentyp nach FHDW-Hinweisen S. 9–10:
  - Buch: Autoren (Nachname, Vorname). Titel. Verlag, Ort, Auflage (falls nicht erste), Jahr.
  - Artikel: Autoren. Titel. Zeitschrift, Band(Heft): Seiten, Jahr.
  - Konferenzbeitrag: Autoren. Titel. In: Herausgeber (Hrsg.), Konferenzband, Serie, Band, Seiten, Jahr.
  - Internetquelle: Autoren. Titel. Magazin (BibTeX howpublished → note), Datum, URL, Zugriffsdatum.
-->
<!-- Hinweis: je Typ ein eigener else-if-Zweig; mehrere Typen in einem type-Attribut
     wertet Typst 0.15 nicht aus. -->
<style xmlns="http://purl.org/net/xbiblio/csl" class="in-text" version="1.0" default-locale="de-DE">
  <info>
    <title>FHDW numerisch</title>
    <id>fhdw-numerisch</id>
    <updated>2026-10-17T00:00:00+00:00</updated>
  </info>
  <locale xml:lang="de">
    <terms>
      <term name="editor" form="short">Hrsg.</term>
      <term name="accessed">Zugriff am</term>
      <term name="edition" form="short">Aufl.</term>
      <term name="in">In:</term>
    </terms>
  </locale>
  <macro name="autoren">
    <names variable="author">
      <name name-as-sort-order="all" sort-separator=", " delimiter="; " delimiter-precedes-last="never" and="text"/>
      <substitute>
        <names variable="editor"/>
      </substitute>
    </names>
  </macro>
  <macro name="herausgeber">
    <names variable="editor">
      <name delimiter=", " and="text"/>
      <label form="short" prefix=" (" suffix=")"/>
    </names>
  </macro>
  <macro name="jahr">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>
  <macro name="auflage">
    <choose>
      <if is-numeric="edition">
        <group delimiter=" ">
          <number variable="edition" form="ordinal"/>
          <text term="edition" form="short"/>
        </group>
      </if>
      <else>
        <text variable="edition"/>
      </else>
    </choose>
  </macro>
  <macro name="zugriff">
    <group delimiter=" ">
      <text term="accessed"/>
      <date variable="accessed" form="numeric" date-parts="year-month-day"/>
    </group>
  </macro>
  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <group delimiter=", ">
        <text variable="citation-number"/>
        <text variable="locator"/>
      </group>
    </layout>
  </citation>
  <bibliography second-field-align="flush" entry-spacing="1">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="]"/>
      <group delimiter=". ">
        <text macro="autoren"/>
        <text variable="title"/>
        <choose>
          <if type="book">
            <group delimiter=", ">
              <text variable="publisher"/>
              <text variable="publisher-place"/>
              <text macro="auflage"/>
              <text macro="jahr"/>
            </group>
          </if>
          <else-if type="article-journal">
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
              <text macro="jahr"/>
            </group>
          </else-if><else-if type="article-magazine">
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
              <text macro="jahr"/>
            </group>
          </else-if><else-if type="article-newspaper">
            <group delimiter=", ">
              <text variable="container-title" font-style="italic"/>
              <group>
                <text variable="volume"/>
                <text variable="issue" prefix="(" suffix=")"/>
              </group>
              <text variable="page"/>
              <text macro="jahr"/>
            </group>
          </else-if>
          <else-if type="paper-conference">
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in"/>
                <text macro="herausgeber"/>
              </group>
              <text variable="container-title" font-style="italic"/>
              <text variable="collection-title"/>
              <text variable="volume"/>
              <text variable="page"/>
              <text variable="publisher"/>
              <text macro="jahr"/>
            </group>
          </else-if><else-if type="chapter">
            <group delimiter=", ">
              <group delimiter=" ">
                <text term="in"/>
                <text macro="herausgeber"/>
              </group>
              <text variable="container-title" font-style="italic"/>
              <text variable="collection-title"/>
              <text variable="volume"/>
              <text variable="page"/>
              <text variable="publisher"/>
              <text macro="jahr"/>
            </group>
          </else-if>
          <else>
            <group delimiter=", ">
              <text variable="container-title"/>
              <text variable="note"/>
              <text variable="publisher"/>
              <text variable="genre"/>
              <date variable="issued" form="numeric" date-parts="year-month-day"/>
              <text variable="URL"/>
              <text macro="zugriff"/>
            </group>
          </else>
        </choose>
      </group>
    </layout>
  </bibliography>
</style>
